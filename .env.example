# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only. Anything NEXT_PUBLIC_*
# is inlined into the client bundle at build time — never put a secret there.
# https://nextjs.org/docs/app/guides/environment-variables

# --- Database (Neon Postgres) ---------------------------------------------
# Create a free project at https://neon.tech and copy the POOLED connection
# string (host contains `-pooler`).
DATABASE_URL="postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) ------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE: don't use `npx auth secret` — the `auth` npm package is now Better Auth's
# CLI and writes BETTER_AUTH_SECRET instead (this file also went missing when
# it was run during setup).
AUTH_SECRET=""

# Only for `next start` outside Vercel (Vercel trusts its host automatically).
# AUTH_TRUST_HOST=true

# --- Site URL (optional) --------------------------------------------------
# Public origin for absolute URLs (sitemap, robots, canonical/OG). Defaults to
# Vercel's production domain, else http://localhost:3000. Set it for a custom
# domain. See docs/06-production.md.
# SITE_URL="https://openroles.example"

# Stretch — OAuth provider. https://authjs.dev/getting-started/authentication/oauth
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# --- Self-hosting only ----------------------------------------------------
# Pin across all instances so Server Actions decrypt everywhere.
# https://nextjs.org/docs/app/guides/self-hosting
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
